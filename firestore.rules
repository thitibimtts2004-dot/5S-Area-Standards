rules_version = '2';

// 5S Area Standards — Firestore security rules (role-based)
// ------------------------------------------------------------
// Access requires an authenticated session. Login is employee-id + PIN,
// implemented on top of Firebase Email/Password auth (the app maps
// <empId> -> <empId>@areastandards.app and uses the PIN as the password).
//
// Two roles, stored in users/{uid}.role:
//   admin     — manages criteria, reference images, users; edits/deletes any record
//   inspector — creates inspections; edits/deletes only their own
//
// SEQUENCING NOTE: do NOT publish these rules until at least one admin
// account exists (users/{uid} with role 'admin') AND the app's login screen
// is live — otherwise the running app, which has no login yet, locks out.
// ------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin is a signed-in user whose users/{uid} doc says role == 'admin'.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User accounts. Any signed-in user may read (to show inspector names);
    // only an admin may create, edit, or deactivate accounts.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // Self-registration (option A): a signed-in user may CREATE only their OWN
      // account doc, hard-locked to inspector + inactive + pending. An admin must
      // approve (flip active->true, pending->false) before login works. This
      // prevents self-promotion to admin and self-activation.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'inspector'
        && request.resource.data.active == false
        && request.resource.data.pending == true;
    }

    match /inspections/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['date', 'area', 'inspector', 'totalScore'])
        && request.resource.data.date is string
        && request.resource.data.area is string
        && request.resource.data.inspector is string
        && request.resource.data.totalScore is number
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 100;

      // Admin may edit/delete anything; an inspector only their own records
      // (records created before this feature have no inspectorUid -> admin-only).
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.inspectorUid == request.auth.uid);

      match /items/{itemId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    // Shared inspection criteria — read by any member, written by admin only.
    match /criteriaSets/{area} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /versions/{version} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Shared standard reference images — read by any member, written by admin only.
    match /refImages/{area} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shared app config — read by any member, written by admin only.
    match /appConfig/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Everything else is denied (default-deny, stated explicitly).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
